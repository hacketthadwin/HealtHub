DATABASE_URL= database_url_here
JWT_SECRET= jwt_secret_here
RAZORPAY_KEY_ID= razorpay_key_id_here
RAZORPAY_KEY_SECRET= razorpay_key_secret_here
GEMINI_API_KEY= gemini_api_key_here

# Cloudinary (for PDF/file uploads)
CLOUDINARY_CLOUD_NAME= cloud_name_here
CLOUDINARY_API_KEY= cloud_api_key_here
CLOUDINARY_API_SECRET= cloud_api_secret_here

# Resend (email service)
RESEND_API_KEY= resend_api_key_here
CONTACT_RECIPIENT_EMAIL= contact_recipient_email_here

# YouTube Data API (for health videos)
YOUTUBE_API_KEY= youtube_api_key_here

# Payment and request limits
PAYMENT_WINDOW_HOURS= chosen_number_here
MAX_ACTIVE_REQUESTS= chosen_number_here

# App
NODE_ENV=production
PORT=5000

# ── Added in this update ─────────────────────────────────────────────────────

# Razorpay webhook (Dashboard > Settings > Webhooks). URL: https://<your-api>/api/v1/payment/webhook
# Subscribe to: payment.captured, order.paid, refund.processed, refund.failed.  Also enable auto-capture.
RAZORPAY_WEBHOOK_SECRET= webhook_secret_here

# Secret for the external scheduler that calls POST /api/v1/internal/run-jobs (header x-cron-secret)
CRON_SECRET= long_random_string_here

# Commission taken from each consultation fee (percent) and the doctor payout via Razorpay Route
PLATFORM_COMMISSION_PERCENT=15
ENABLE_ROUTE_PAYOUTS=false

# Hours a doctor has to answer a request, and the full-refund cancellation cutoff for patients
DOCTOR_RESPONSE_HOURS=48
FREE_CANCEL_HOURS=24

# Sender for emails (must be a verified Resend domain in production)
EMAIL_FROM= HealthHub <noreply@your-domain.com>

# Optional SMS / WhatsApp reminders through Twilio (NOTIFY_CHANNEL = none | sms | whatsapp)
NOTIFY_CHANNEL=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Extra allowed frontend origins, comma-separated (e.g. a custom domain)
EXTRA_ALLOWED_ORIGINS=
